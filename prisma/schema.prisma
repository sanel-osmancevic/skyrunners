// Baza za lokalni razvoj je SQLite (fajl prisma/dev.db).
// Za produkciju promeni provider na "postgresql" i DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js modeli (ne menjati nazive kolona) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // MEMBER | ADMIN
  role          String    @default("MEMBER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  profile  MemberProfile?
  races    RaceResult[]
  clubRaces ClubRace[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Podaci člana kluba ----------
// Red postoji tek kada član popuni formu posle prvog logovanja.

model MemberProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Lični podaci
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      String // M | Z
  phone       String
  city        String
  address     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Istrčane trke (rezultati članova) ----------
// Član bira trku i distancu iz kalendara (trka.rs) i upisuje vreme. place = individualno, agePlace = AGE (starosna) kategorija, teamPlace = timsko postolje (1, 2 ili 3).

model RaceResult {
  id         String   @id @default(cuid())
  userId     String
  name       String
  date       DateTime
  distanceKm Float
  place      Int?
  teamPlace  Int?
  agePlace   Int?

  // Podaci o izabranoj trci (name, date i distanceKm se kopiraju pri unosu).
  // trkaEventId je ID trke u kalendaru: broj sa trka.rs, "rt-..." (runtrace.net) ili "club-..." (dodata ručno).
  trkaEventId String?
  trkaRaceId  String?
  raceName    String?
  timeSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Trke koje članovi dodaju ručno (kad ih nema ni u jednom izvoru) ----------

model ClubRace {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  location    String?
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  distances ClubRaceDistance[]
}

model ClubRaceDistance {
  id         String @id @default(cuid())
  raceId     String
  distanceKm Float

  race ClubRace @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, distanceKm])
}
